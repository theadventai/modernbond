# Supabase — Project Settings → API
# These are public (the anon key is safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SNIPCART_API_KEY=your-snipcart-live-public-key
# Secret key (server-side only — never prefix with NEXT_PUBLIC_)
SNIPCART_SECRET_KEY=your-snipcart-secret-key
